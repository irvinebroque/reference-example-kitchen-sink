{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reference-example-kitchen-sink-statsig",
	"main": "./workers/statsig/index.ts",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"cache": {
		"enabled": false,
		"cross_version_cache": false,
	},
	"exports": {
		"default": {
			"type": "worker",
			"cache": { "enabled": false },
		},
		"FeatureGatewayEntrypoint": {
			"type": "worker",
			"cache": { "enabled": false },
		},
		"DecisionCacheEntrypoint": {
			"type": "worker",
			"cache": { "enabled": true },
		},
	},
	"vars": {
		"APP_ID": "reference-app",
		"APP_ENVIRONMENT": "production",
		"TENANT_ID": "reference-tenant",
		"EVALUATOR_VERSION": "local",
		"CONFIG_SPECS_CACHE_BACKEND": "isolate",
		"CONFIG_SPECS_TTL_SECONDS": "300",
		"DECISIONS_TTL_SECONDS": "60",
		"DECISIONS_STALE_SECONDS": "300",
		"STATSIG_EXPOSURE_LOGGING_ENABLED": "true",
		"STATSIG_PRODUCT_EVENT_LOGGING_ENABLED": "false",
	},
	"secrets": {
		"required": ["STATSIG_SERVER_SECRET"],
	},
	"env": {
		"staging": {
			"name": "reference-example-kitchen-sink-statsig-staging",
			"vars": {
				"APP_ID": "reference-app",
				"APP_ENVIRONMENT": "staging",
				"TENANT_ID": "reference-tenant",
				"EVALUATOR_VERSION": "staging",
				"CONFIG_SPECS_CACHE_BACKEND": "isolate",
				"CONFIG_SPECS_TTL_SECONDS": "60",
				"DECISIONS_TTL_SECONDS": "30",
				"DECISIONS_STALE_SECONDS": "60",
				"STATSIG_EXPOSURE_LOGGING_ENABLED": "true",
				"STATSIG_PRODUCT_EVENT_LOGGING_ENABLED": "true",
			},
			"secrets": {
				"required": ["STATSIG_SERVER_SECRET"],
			},
		},
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"upload_source_maps": true,
}
