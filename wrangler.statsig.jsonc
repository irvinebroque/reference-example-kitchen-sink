{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reference-example-kitchen-sink-statsig",
	"main": "./workers/statsig/index.ts",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": ["nodejs_compat", "memory_cache_delete"],
	"workers_dev": false,
	"preview_urls": false,
	"cache": {
		"enabled": false,
		"cross_version_cache": false,
	},
	"exports": {
		"default": {
			"type": "worker",
			"cache": { "enabled": false },
		},
		"FeatureGatewayEntrypoint": {
			"type": "worker",
			"cache": { "enabled": false },
		},
		"DecisionCacheEntrypoint": {
			"type": "worker",
			"cache": { "enabled": true },
		},
	},
	"vars": {
		"APP_ID": "reference-app",
		"APP_ENVIRONMENT": "production",
		"TENANT_ID": "reference-tenant",
		"EVALUATOR_VERSION": "local",
		"CONFIG_SPECS_TTL_SECONDS": "300",
		"DECISIONS_TTL_SECONDS": "60",
		"DECISIONS_STALE_SECONDS": "300",
	},
	"secrets": {
		"required": ["STATSIG_SERVER_SECRET", "INVALIDATION_SECRET"],
	},
	"unsafe": {
		"bindings": [
			{
				"name": "CONFIG_SPECS_CACHE",
				"type": "volatile_cache",
				"cache_id": "reference-example-kitchen-sink-statsig-config-specs",
				"max_keys": 4,
				"max_value_size": 67108864,
				"max_total_value_size": 134217728,
			},
		],
	},
	"env": {
		"staging": {
			"name": "reference-example-kitchen-sink-statsig-staging",
			"vars": {
				"APP_ID": "reference-app",
				"APP_ENVIRONMENT": "staging",
				"TENANT_ID": "reference-tenant",
				"EVALUATOR_VERSION": "staging",
				"CONFIG_SPECS_TTL_SECONDS": "60",
				"DECISIONS_TTL_SECONDS": "30",
				"DECISIONS_STALE_SECONDS": "60",
			},
			"secrets": {
				"required": ["STATSIG_SERVER_SECRET", "INVALIDATION_SECRET"],
			},
			"unsafe": {
				"bindings": [
					{
						"name": "CONFIG_SPECS_CACHE",
						"type": "volatile_cache",
						"cache_id": "reference-example-kitchen-sink-statsig-staging-config-specs",
						"max_keys": 4,
						"max_value_size": 67108864,
						"max_total_value_size": 134217728,
					},
				],
			},
		},
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"upload_source_maps": true,
}
