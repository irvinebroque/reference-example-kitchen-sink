{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reference-example-kitchen-sink-app",
	"main": "./workers/app/server.ts",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": ["nodejs_compat"],
	"cache": {
		"enabled": false,
	},
	"exports": {
		"default": {
			"type": "worker",
			"cache": { "enabled": false },
		},
	},
	"services": [
		{
			"binding": "STATSIG_SERVICE",
			"service": "reference-example-kitchen-sink-statsig",
			"entrypoint": "EvaluationEntrypoint",
		},
	],
	"vars": {
		"APP_ID": "reference-app",
		"APP_ENVIRONMENT": "production",
		"APP_VERSION": "local",
		"STATSIG_CLIENT_KEY": "client-reference-example",
	},
	"secrets": {
		"required": ["AUTH_SECRET", "NEXTAUTH_URL", "DEMO_USERNAME", "DEMO_PASSWORD_HASH", "USER_CACHE_HMAC_SECRET"],
	},
	"previews": {
		"vars": {
			"APP_ID": "reference-app",
			"APP_ENVIRONMENT": "preview",
			"APP_VERSION": "preview",
			"STATSIG_CLIENT_KEY": "client-reference-example",
		},
		"services": [
			{
				"binding": "STATSIG_SERVICE",
				"service": "reference-example-kitchen-sink-statsig-staging",
				"entrypoint": "EvaluationEntrypoint",
			},
		],
		"cache": {
			"enabled": false,
		},
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"preview_urls": true,
	"upload_source_maps": true,
}
