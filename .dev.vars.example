AUTH_SECRET=replace-with-at-least-32-random-bytes
DEMO_USERNAME=demo
DEMO_PASSWORD_DISPLAY=demo-password
DEMO_PASSWORD_HASH=pbkdf2_sha256$100000$replace-salt$replace-hex-digest
# Evaluator-only in deployed environments; shared locally by the auxiliary Worker.
STATSIG_SERVER_SECRET=secret-replace
STATSIG_EXPOSURE_LOGGING_ENABLED=false
