{
	"name": "reference-example-kitchen-sink",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "WRANGLER_LOG_PATH=/tmp/wrangler.log react-router build",
		"check": "npm run typecheck && npm run test:run && npm run guard:no-cache-api && npm run guard:feature-boundary",
		"cf-typegen": "WRANGLER_LOG_PATH=/tmp/wrangler.log wrangler types && WRANGLER_LOG_PATH=/tmp/wrangler.log wrangler types --config wrangler.statsig.jsonc --env-interface StatsigEnv worker-statsig-configuration.d.ts",
		"deploy": "npm run build && wrangler deploy --config wrangler.statsig.jsonc --env=\"\" && wrangler deploy",
		"deploy:app": "npm run build && wrangler deploy",
		"deploy:statsig": "wrangler deploy --config wrangler.statsig.jsonc --env=\"\"",
		"deploy:statsig:staging": "wrangler deploy --config wrangler.statsig.jsonc --env staging",
		"dev": "vite",
		"guard:no-cache-api": "node scripts/guard-no-cache-api.mjs",
		"guard:feature-boundary": "node scripts/guard-feature-boundary.mjs",
		"hash-password": "node scripts/hash-demo-password.mjs",
		"benchmark:config-specs": "node scripts/benchmark-config-specs.mjs",
		"preview": "wrangler preview",
		"start": "vite",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "WRANGLER_LOG_PATH=/tmp/wrangler.log react-router typegen && tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.47.0",
		"@react-router/dev": "8.3.0",
		"@types/node": "^26.1.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"typescript": "^5.5.2",
		"vite": "8.1.5",
		"vitest": "~3.2.0",
		"wrangler": "https://pkg.pr.new/wrangler@14868"
	},
	"dependencies": {
		"@cloudflare/kumo": "^2.8.0",
		"@statsig/serverless-client": "3.33.3",
		"next": "16.2.12",
		"next-auth": "4.24.15",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.0",
		"zod": "4.4.3"
	},
	"overrides": {
		"@cloudflare/vite-plugin": {
			"miniflare": "https://pkg.pr.new/cloudflare/workers-sdk/miniflare@bd9b599"
		}
	}
}
